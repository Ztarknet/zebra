[Unit]
Description=Zebra Zcash Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{ZEBRA_DIR}}
ExecStart={{ZEBRA_DIR}}/target/release/zebrad --config {{ZEBRA_DIR}}/deploy/ztarknet.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zebrad

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ZEBRA_DIR}}/.cache

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
